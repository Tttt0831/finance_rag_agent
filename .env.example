# ========================================
# 金融 Agent 项目环境变量配置模板
# 复制此文件为 .env，填入真实值，不要提交 .env 到 git
# ========================================

# DeepSeek API Key（在 https://platform.deepseek.com/ 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖默认模型 / 接口地址（任何 OpenAI 兼容服务均可）
# MODEL_NAME=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 向量库持久化路径（默认即可）
CHROMA_PERSIST_DIR=./data/chroma_db

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ── 生产化升级开关（可选，默认即最优，一般无需修改）────────────
# 混合检索 BM25+RRF（默认开）
# ENABLE_HYBRID=true
# 查询改写（默认关，开启多一次 LLM 调用）
# ENABLE_QUERY_REWRITE=false
# Rerank 精排（默认关，开启需下载 bge-reranker 模型约 1~2GB）
# ENABLE_RERANK=false
# 父子块切分（默认关，开启后需删除 data/chroma_db 重建索引）
# ENABLE_PARENT_CHILD=false

# Agent 熔断 / 压缩水位（默认即可）
# MAX_STEPS=8
# MAX_TOTAL_TOKENS=40000
# COMPACTION_THRESHOLD_TOKENS=8000
# CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
